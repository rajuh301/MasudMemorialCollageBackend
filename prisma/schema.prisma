generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  role               UserRole
  needPasswordChange Boolean    @default(true)
  status             UserStatus @default(ACTIVE)
  contactNumber      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin            Admin?
  teacher          Teacher?
  student          Student?
  officeStaff      OfficeStaff?
  studentAdmission StudentAdmission?

  @@map("users")
}

model Admin {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  profilePhoto  String?
  contactNumber String
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdTeachers     Teacher[]     @relation("AdminToTeacher")
  createdOfficeStaffs OfficeStaff[] @relation("AdminToOfficeStaff")
  approvedLeaves      Leave[]       @relation("AdminToLeave")

  @@map("admins")
}

model Teacher {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  profilePhoto   String?
  contactNumber  String
  joiningDate    DateTime
  address        String
  faceDescriptor Float[]
  designation    String

  createdById String
  createdBy   Admin? @relation("AdminToTeacher", fields: [createdById], references: [id])

  isDeleted        Boolean @default(false)
  isPasswordChange Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdStudents Student[]    @relation("TeacherToStudent")
  attendances     Attendance[]
  leaves          Leave[]      @relation("TeacherToLeave")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@map("teachers")
}

model OfficeStaff {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  profilePhoto   String?
  contactNumber  String
  joiningDate    DateTime
  address        String
  faceDescriptor Float[]

  // Default password is built from dateOfBirth (DD/MM/YYYY)
  dateOfBirth DateTime

  designation String
  createdById String
  createdBy   Admin? @relation("AdminToOfficeStaff", fields: [createdById], references: [id])

  isDeleted        Boolean @default(false)
  isPasswordChange Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[] @relation("OfficeStaffToAttendance")
  leaves      Leave[]      @relation("OfficeStaffToLeave")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@map("officeStaff")
}

model GovermentBody {
  id          String @id @default(uuid())
  name        String
  image       String
  description String

  @@map("govermentBody")
}

model Member {
  id          String @id @default(uuid())
  name        String
  image       String
  description String

  @@map("member")
}

model Attendance {
  id            String       @id @default(uuid())
  teacherId     String?
  teacher       Teacher?     @relation(fields: [teacherId], references: [id])
  officeStaffId String?
  officeStaff   OfficeStaff? @relation("OfficeStaffToAttendance", fields: [officeStaffId], references: [id])
  date          DateTime     @default(now())
  status        String       @default("PRESENT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendances")
}

model Student {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  phone        String
  profilePhoto String?
  isDeleted    Boolean @default(false)

  isPasswordChange Boolean @default(true)

  teacherCreatedById String?
  teacherCreatedBy   Teacher? @relation("TeacherToStudent", fields: [teacherCreatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  leaves Leave[] @relation("StudentToLeave")

  @@map("students")
}

model Result {
  id           String     @id @default(uuid())
  studentRoll  String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  subject      String
  marks        Float
  grade        String
  examType     String
  academicYear Int

  createdAt DateTime @default(now())

  @@unique([studentRoll, subject, examType, academicYear])
  @@map("results")
}

model ResultSummary {
  id            String @id @default(uuid())
  year          Int    @unique
  totalStudents Int
  goldenPlus    Int    @default(0)
  aPlus         Int    @default(0)
  aGrade        Int    @default(0)
  aMinus        Int    @default(0)
  passRate      Float  @default(0.0)

  updatedAt DateTime @updatedAt

  @@map("result_summaries")
}

model Department {
  id          String @id @default(uuid())
  name        String
  year        String
  description String
 studentNotices StudentNotice[] @relation("DepartmentToStudentNotice")
  results          Result[]
  StudentAdmission StudentAdmission[]
}

model StudentAdmission {
  id               String        @id @default(uuid())
  studentRoll      String        @unique
  firstName        String
  lastName         String
  email            String?       @unique
  phone            String
  dateOfBirth      DateTime
  gender           Gender
  bloodGroup       BloodGroup
  maritalStatus    MaritalStatus
  presentAddress   String
  permanentAddress String

  guardianName     String
  guardianPhone    String
  guardianRelation String

  previousSchool String
  previousGPA    Float
  passingYear    Int

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  studentNotices StudentNotice[] @relation("StudentToStudentNotice")

  subjects String[]

  admissionDate DateTime @default(now())

  admissionFee  Float?
  paymentStatus PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     String?

  isDeleted Boolean @default(false)

  // Linked User account (created automatically on admission)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@map("student_admissions")
}

model Banner {
  id String @id @default(uuid())

  title       String
  subTitle    String
  description String
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  @@map("banners")
}

model SubBanner {
  id String @id @default(uuid())

  title       String
  subTitle    String
  description String
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subBanners")
}

model Notice {
  id String @id @default(uuid())

  title           String
  description     String
  isImportant     Boolean
  isRecentNotice  Boolean
  isAcademicNotic Boolean  @default(false)
  isOfficialNotic Boolean  @default(false)
  date            DateTime

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notices")
}

model StudentNotice {
  id           String @id @default(uuid())

  departmentId String
  department   Department @relation("DepartmentToStudentNotice", fields: [departmentId], references: [id])

  studentRoll  String

  studentId    String
  student      StudentAdmission @relation("StudentToStudentNotice", fields: [studentId], references: [id])

  description  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_notices")
}

model Leave {
  id        String      @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  adminNote String?

  studentId String?
  student   Student? @relation("StudentToLeave", fields: [studentId], references: [id])

  teacherId String?
  teacher   Teacher? @relation("TeacherToLeave", fields: [teacherId], references: [id])

  officeStaffId String?
  officeStaff   OfficeStaff? @relation("OfficeStaffToLeave", fields: [officeStaffId], references: [id])

  approvedById String?
  approvedBy   Admin?  @relation("AdminToLeave", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leaves")
}

model Payment {
  id String @id @default(uuid())

  studentRoll  String
  studentName  String
  studentEmail String?
  studentPhone String

  amount        Float
  serviceCharge Float @default(0)
  totalAmount   Float

  paymentType PaymentType
  description String?

  spgTranId      String? @unique
  merchantTranId String  @unique

  status PaymentStatus @default(UNPAID)

  spgResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Event {
  id String @id @default(uuid())

  title       String
  description String
  location    String
  date        DateTime
  image       String?

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model StudentsComment {
  id String @id @default(uuid())

  name        String
  description String
  batch       String
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studentsComments")
}

model OurTeachers {
  id String @id @default(uuid())

  name        String
  position    String
  subject     String
  description String
  rating      String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       String?

  @@map("ourTeachers")
}

model Contact {
  id String @id @default(uuid())

  name    String
  email   String
  comment String
  phone   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

model News {
  id String @id @default(uuid())

  lable     String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Float
  type        TransactionType
  purpose     String
  category    String
  reference   String?
  date        DateTime        @default(now())
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TransactionType {
  CASH_IN
  CASH_OUT
}

enum PaymentType {
  ADMISSION_FEE
  SEMESTER_FEE
  EXAM_FEE
  OTHER
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  OFFICESTAFF
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum BloodGroup {
  A_POSITIVE
  B_POSITIVE
  O_POSITIVE
  AB_POSITIVE
  A_NEGATIVE
  B_NEGATIVE
  O_NEGATIVE
  AB_NEGATIVE
}

enum MaritalStatus {
  MARRIED
  UNMARRIED
}
